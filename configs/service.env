# 爱快信息；实际密码请通过 Docker 环境变量或本机配置传入，勿提交到 GitHub。
ROUTER_USERNAME=cloudflare
ROUTER_PASSWORD=
ROUTER_IP=192.168.1.1
ROUTER_PORT=80
TZ=Asia/Shanghai

SELECT_NUM=3               # 每个域名独立选取延迟最低的有效 IP 数量
CRON=0 * * * *             # 五位 cron：默认每小时整点，可自定义；上一轮未结束时跳过重叠调度
ENABLE_V6=false
LOG_LEVEL=info

# 公共候选初筛：只测 HTTP 延迟，不测试下载。
DISABLE_DOWNLOAD=true
HTTP_PING=true
HTTP_PING_CODE=204
URL=https://cp.cloudflare.com/generate_204
TEST_PORT=443
THREAD=100
DELAYED_TESTS=2
TIME_LIMIT=1000            # 公共 HTTP 初筛平均延迟上限（ms）
TIME_LOWER_LIMIT=0
LOSS_RATE=0.2              # 初筛丢包率及逐域名连接失败率上限；0 表示不接受失败
SPEED_LIMIT=0

# 首次扫描 ip.txt 完整范围；后续复测保留候选，并轮换探索新 /24 网段。
CANDIDATE_POOL_SIZE=64
EXPLORE_NUM=32

# 逐域名测速：每个候选新建 TLS 连接，带目标域名 SNI 并验证证书，不发送下载请求。
DOMAIN_CANDIDATE_NUM=24    # 从初筛中取前多少个 IP，再加入该域名现有规则 IP
DOMAIN_TESTS=3             # 每个域名、每个 IP 的连接测试次数（至少 2）
DOMAIN_TIMEOUT_MS=2000     # 单次 TCP 建连及 TLS 握手的总超时
DOMAIN_TIME_LIMIT=2000     # 可写入候选的平均 TLS 连接耗时上限（ms）
DOMAIN_CONCURRENCY=32      # 全部域名共享的最大连接并发数
